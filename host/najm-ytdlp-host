def resolve_file(candidate, out_dir):
    if not isinstance(candidate, str) or not candidate:
        return None
    if RE_CTRL.search(candidate):
        return None
    p = pathlib.Path(candidate)
    if not p.is_file():
        return None
    try:
        real = os.path.realpath(candidate)
    except OSError:
        return None
    base = os.path.realpath(out_dir)
    head = base if base.endswith(os.sep) else base + os.sep
    if not real.startswith(head):
        return None
    return real


def split_sections(main_file):
    """Section files produced by --split-chapters next to the (kept) original.

    yt-dlp >=2025 keeps the whole video and reports only the original path via
    the after_move NJDP:FILE print, so the section files are derived from the
    main filename (same dir + stem, then " - NN_title<ext>"). Returns [] when
    nothing matched, so callers keep the original file as a safe fallback.
    """
    if not isinstance(main_file, str) or not main_file:
        return []
    d = os.path.dirname(main_file)
    stem, ext = os.path.splitext(os.path.basename(main_file))
    re_section = re.compile(
        re.escape(stem) + r" - [0-9]{2,}_.*" + re.escape(ext) + r"\Z")
    out = []
    for cand in sorted(glob.glob(os.path.join(d, stem + " - [0-9][0-9]*_*" + ext))):
        if cand == main_file:
            continue
        if RE_CTRL.search(cand) or not re_section.match(os.path.basename(cand)):
            continue
        if os.path.isfile(cand):
            out.append(cand)
    return out


def build_command(url, sel, with_subs=True):
    out_dir = sel.get("outputDir")
    if not isinstance(out_dir, str) or not out_dir.replace("/", "").strip():
        out_dir = DEFAULT_DIR
    out_dir = os.path.expanduser(out_dir)
    os.makedirs(out_dir, exist_ok=True)

    playlist = sel.get("playlist") is True
    is_pl = playlist and ("list=" in (url or "").lower() or "/playlist" in (url or "").lower())
    audio_only = sel.get("audioOnly") is True
    audio_fmt = sel.get("audioFmt")
    if audio_fmt not in ("best", "m4a", "mp3", "opus"):
        audio_fmt = "best"

    format_id = sel.get("formatId")
    if not isinstance(format_id, str) or not RE_FMTID.fullmatch(format_id):
        format_id = None
    format_has_audio = format_id is not None and sel.get("formatHasAudio") is True

    cmd = [YTDLP, "--newline", "--progress", "--no-warnings"]
    cmd += ["--yes-playlist"] if is_pl else ["--no-playlist"]
    if is_pl:
        cmd += ["--ignore-errors"]

    if audio_only:
        if format_id is not None:
            fsel = format_id
        else:
            fsel = "ba/b"
        cmd += ["-f", fsel]
        cmd += ["-x", "--audio-format", audio_fmt]
        out_tpl = (
            "%(playlist_title)s/%(playlist_index)03d_%(title)s.%(ext)s"
            if is_pl else "%(title)s.%(ext)s"
        )
    else:
        merge_ext = ""
        if format_id is not None:
            if format_has_audio:
                fsel = format_id
            else:
                ext = sel.get("formatExt")
                ext = ext.lower() if isinstance(ext, str) else ""
                if ext in MERGE_CONTAINERS and ext != "best":
                    fsel = f"{format_id}+ba[ext={ext}]/{format_id}+ba/b"
                    merge_ext = ext
                else:
                    fsel = format_id + "+ba/b"
            if is_pl:
                fsel += "/bv*+ba/b"
            cmd += ["-f", fsel]
            if merge_ext:
                cmd += ["--merge-output-format", merge_ext]
        else:
            res = sel.get("resolution")
            res = str(res).strip() if res is not None else "best"
            if res == "best" or res == "" or RE_INT.fullmatch(res) is None:
                cmd += ["-f", "bv*+ba/b"]
            else:
                h = max(1, min(int(res), 4320))
                cap = f"[height<={h}]"
                cmd += ["-f", f"bv*{cap}+ba/b{cap}"]
        container = sel.get("container")
        if container not in MERGE_CONTAINERS:
            container = "best"
        if container != "best":
            cmd += ["--merge-output-format", container]
        out_tpl = (
            "%(playlist_title)s/%(playlist_index)03d_%(title)s.%(ext)s"
            if is_pl else "%(title)s.%(ext)s"
        )

    chapters = sel.get("chapters")
    if chapters not in ("embed", "split"):
        chapters = None
    if chapters and not audio_only:
        if chapters == "embed":
            cmd += ["--embed-chapters"]
        else:
            cmd += ["--split-chapters"]
            chapter_tpl = (
                ("%(playlist_title)s/%(playlist_index)03d_%(title)s - "
                 "%(section_number)02d_%(section_title)s.%(ext)s" if is_pl else
                 "%(title)s - %(section_number)02d_%(section_title)s.%(ext)s"))
            cmd += ["-o", "chapter:" + chapter_tpl]

    cmd += ["--paths", out_dir, "-o", out_tpl]

    AUTO_ALL = "en"
    if with_subs:
        subs = sel.get("subs") or {}
        if subs.get("on") is True:
            cmd += ["--write-subs"]
            if subs.get("auto") is True:
                cmd += ["--write-auto-subs"]
            langs = subs.get("langs")
            if langs == "all" or not (isinstance(langs, str) and RE_LANG.fullmatch(langs)):
                langs = AUTO_ALL if (subs.get("auto") is True) else "all"
            cmd += ["--sub-langs", langs]
            sub_fmt = subs.get("subFormat")
            if not (isinstance(sub_fmt, str) and RE_LANG.fullmatch(sub_fmt) and len(sub_fmt) <= 12):
                sub_fmt = "best/srt"
            cmd += ["--sub-format", sub_fmt]
            convert = subs.get("convert")
            if sub_fmt == "srt":
                convert = "srt"
            if convert in ("srt", "vtt"):
                cmd += ["--convert-subs", convert]
            if subs.get("embed") is True:
                cmd += ["--embed-subs", "--embed-metadata"]

    cmd += [
        "--progress-template",
        "download:NJDP:PCT\t%(progress._percent_str)s\t%(progress._speed_str)s\t%(progress._eta_str)s\t%(progress.downloaded_bytes)s\t%(progress.total_bytes|total_bytes_estimate)s",
        "--print", "after_move:NJDP:FILE\t%(filepath)s",
        "--print", "after_move:NJDP:TITLE\t%(title)j",
        "--",
        url,
    ]
    return cmd, out_dir


def osd_available():
    return not os.environ.get("NDLP_NO_OMARCHY") and omarchy_tool("omarchy-osd") is not None


def osd_progress(pct_int):
    tool = omarchy_tool("omarchy-osd")
    if not tool or os.environ.get("NDLP_NO_OMARCHY"):
        return
    try:
        subprocess.run(
            [tool, "-i", OSD_ICON_DOWNLOAD, "-p", str(pct_int), "-d", "8000"],
            check=False, timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def osd_close():
    tool = omarchy_tool("omarchy-shell")
    if not tool or os.environ.get("NDLP_NO_OMARCHY"):
        return
    try:
        subprocess.run([tool, "-q", "osd", "close"],
                       check=False, timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def notify_done(title, filepath):
    if not os.path.isfile(filepath):
        return
    image = None
    if os.path.exists(FFMPEG):
        fd, preview = tempfile.mkstemp(suffix=".jpg")
        os.close(fd)
        try:
            crop = "crop='min(iw,ih)':'min(iw,ih)',scale=256:256"
            subprocess.run(
                [FFMPEG, "-y", "-i", filepath, "-ss", "00:00:00.1",
                 "-vframes", "1", "-vf", crop, "-q:v", "2", preview, "-loglevel", "quiet"],
                check=False, timeout=30)
            if os.path.getsize(preview) == 0:
                os.unlink(preview)
                preview = None
        except Exception:
            preview = None
        image = preview or None

    omarchy_send = omarchy_tool("omarchy-notification-send")
    if omarchy_send and not os.environ.get("NDLP_NO_OMARCHY"):
        args = [omarchy_send, "-g", OSD_ICON_DONE, "Download complete", title, "-t", "10000"]
        if image:
            args += ["--image", image]
        args += ["--exec", "mpv", "--", filepath]
        try:
            subprocess.run(args, check=False, timeout=15)
        except Exception:
            pass
    else:
        args = ["notify-send", "-a", "Najm Downloader", "-t", "10000"]
        if image:
            args += ["-i", image]
        args += [title, "Download complete", "--action=play=Play with mpv"]
        try:
            subprocess.run(args, check=False, timeout=15)
        except Exception:
            pass

    if image:
        def _rm():
            try:
                if os.path.exists(image):
                    os.unlink(image)
            except OSError:
                pass
        threading.Timer(8.0, _rm).start()


def notify_many(count, first_title, out_dir):
    title = clean(first_title, 200) or "Playlist download"
    body = f"{count} files saved"
    omarchy_send = omarchy_tool("omarchy-notification-send")
    if omarchy_send and not os.environ.get("NDLP_NO_OMARCHY"):
        try:
            subprocess.run(
                [omarchy_send, "-g", OSD_ICON_DONE, "Playlist downloaded",
                 f"{body} · {title}", "-t", "10000",
                 "--exec", "xdg-open", "--", out_dir],
                check=False, timeout=15)
        except Exception:
            pass
        return
    try:
        subprocess.run(
            ["notify-send", "-a", "Najm Downloader", "-t", "10000",
             "Playlist downloaded", f"{body}\n{out_dir}"],
            check=False, timeout=15)
    except Exception:
        pass


def notify_error(message):
    if not isinstance(message, str) or not message:
        return
    msg = clean(message, 300) or "Download failed"
    omarchy_send = omarchy_tool("omarchy-notification-send")
    if omarchy_send and not os.environ.get("NDLP_NO_OMARCHY"):
        try:
            subprocess.run(
                [omarchy_send, "-u", "critical", "-g", OSD_ICON_FAIL, "Download failed", msg],
                check=False, timeout=15)
        except Exception:
            pass
        return
    try:
        subprocess.run(["notify-send", "-a", "Najm Downloader", "-u", "critical",
                        "Download failed", msg], check=False, timeout=15)
    except Exception:
        pass


def download_worker(req, payload):
    global current_proc, cancel_flag
    # A cancel can arrive before this worker starts (queued frame); the flag
    # must never leak into a fresh download.
    cancel_flag = False
    url = http_url(payload.get("url"))
    if url is None:
        send({"req": req, "event": "error", "message": "Unsupported URL"})
        set_busy(False)
        return
    sel = payload.get("selection")
    if not isinstance(sel, dict):
        sel = {}

    send({"req": req, "event": "start"})
    items = []
    if osd_available():
        osd_progress(0)
    osd_state = {"int": -1, "ms": 0.0}

    is_pl = (sel.get("playlist") is True and
             ("list=" in (url or "").lower() or "/playlist" in (url or "").lower()))

    SUB_RATELIMITED = ("Subtitles didn't download — the site is rate-limiting subtitle "
                       "requests (HTTP 429). Try again in a few minutes.")
    SUB_FAILED = ("Subtitles didn't download — the site didn't serve them. "
                  "The video was saved without subtitles.")

    lock_log = []

    def _ratelimited(*texts):
        return any(RE_RATELIMIT.search(t) for t in texts if t)

    def _cancel_pending():
        with STATE_LOCK:
            return cancel_flag

    def _sleep_until(delay):
        # Slice the backoff so a cancel lands in milliseconds, not seconds.
        end = time.monotonic() + delay
        while True:
            if _cancel_pending():
                return False
            remaining = end - time.monotonic()
            if remaining <= 0:
                return True
            time.sleep(min(remaining, 0.1))

    def subtitle_lock_ok():
        # "ok" subs served fine · "cancelled" user stopped mid-probe ·
        # "unknown" inconclusive (timeout or a non-subtitle failure — proceed
        # and let the real run decide) · "blocked" subtitle-specific failure,
        # give up and skip subs. Runs in a scratch dir so a cancelled/blocked
        # probe never leaves subtitle files in the real output dir, and is
        # terminated promptly by cancel.
        global lock_proc
        lock_sel = dict(sel)
        tmp_dir = tempfile.mkdtemp(prefix="najm-sublock-")
        lock_sel["outputDir"] = tmp_dir
        try:
            cmd, _ = build_command(url, lock_sel, with_subs=True)
            if "--" in cmd:
                cmd.insert(cmd.index("--"), "--skip-download")
            if is_pl and "--" in cmd:
                i = cmd.index("--")
                cmd[i:i] = ["--playlist-items", "1"]
            for attempt in range(3):
                if _cancel_pending():
                    return "cancelled"
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                    text=True)
                with STATE_LOCK:
                    lock_proc = proc
                try:
                    _out, err = proc.communicate(timeout=SUB_LOCK_TIMEOUT)
                except subprocess.TimeoutExpired:
                    with STATE_LOCK:
                        if lock_proc is proc:
                            lock_proc = None
                    proc.kill()
                    try:
                        proc.communicate(timeout=5)
                    except (subprocess.TimeoutExpired, OSError):
                        pass
                    return "unknown"
                finally:
                    with STATE_LOCK:
                        if lock_proc is proc:
                            lock_proc = None
                if _cancel_pending():
                    return "cancelled"
                if proc.returncode == 0:
                    return "ok"
                lock_log.append(err)
                if not any(RE_SUB_ERROR.search(l) for l in (err or "").splitlines()):
                    return "unknown"
                if attempt < 2 and not _sleep_until(2 * (attempt + 1)):
                    return "cancelled"
            return "blocked"
        finally:
            shutil.rmtree(tmp_dir, ignore_errors=True)

    def run_one(with_subs):
        global current_proc
        nonlocal items
        cmd, out_dir = build_command(url, sel, with_subs=with_subs)
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, bufsize=1)
        current_proc = proc
        errors = []
        last_ev = [0.0]
        titles = {}
        last_file = [None]
        for raw in proc.stdout:
            line = RE_ANSI.sub("", raw.rstrip("\r\n")).strip()
            if not line:
                continue
            if line.startswith("ERROR:"):
                errors.append(line[6:].strip()[:500])
                continue
            if line.startswith("NJDP:PCT\t"):
                parts = line.split("\t")
                try:
                    pct = float(parts[1].replace("%", "").strip())
                except (IndexError, ValueError):
                    continue
                speed = clean(parts[2]) if len(parts) > 2 else None
                eta = clean(parts[3]) if len(parts) > 3 else None
                def _n(i):
                    try:
                        v = int(float(parts[i].strip().replace(",", "")))
                        return v if v > 0 else None
                    except (IndexError, ValueError):
                        return None
                downloaded = _n(4)
                total = _n(5)
                now = time.monotonic()
                if now - last_ev[0] >= 0.25:
                    last_ev[0] = now
                    send({"req": req, "event": "progress",
                          "pct": round(pct, 1), "speed": speed, "eta": eta,
                          "downloaded": downloaded, "total": total})
                if osd_available():
                    ipct = int(pct)
                    if ipct != osd_state["int"] and now - osd_state["ms"] >= 0.25:
                        osd_state["int"], osd_state["ms"] = ipct, now
                        osd_progress(ipct)
                continue
            if line.startswith("NJDP:FILE\t"):
                real = resolve_file(line.split("\t", 1)[1], out_dir)
                if real and real not in items:
                    items.append(real)
                    last_file[0] = real
                    if not sel.get("playlist"):
                        send({"req": req, "event": "file", "filepath": real})
                continue
            if line.startswith("NJDP:TITLE\t"):
                raw = line.split("\t", 1)[1].strip()
                try:
                    raw = json.loads(raw)
                except (ValueError, TypeError):
                    pass
                t = clean(raw, 200) if isinstance(raw, str) else None
                if t and last_file[0]:
                    titles[last_file[0]] = t
                    last_file[0] = None
                continue
        proc.wait()
        return proc.returncode, out_dir, errors, titles

    warn_subs = None
    subs_on = bool((sel.get("subs") or {}).get("on"))
    if subs_on:
        lock = subtitle_lock_ok()
        if lock == "cancelled":
            osd_close()
            send({"req": req, "event": "cancelled", "items": items})
            cancel_flag = False
            set_busy(False)
            return
        if lock == "blocked":
            warn_subs = SUB_RATELIMITED if _ratelimited("\n".join(lock_log)) else SUB_FAILED
            send({"req": req, "event": "info", "message": warn_subs})

    rc, out_dir, errors, titles = run_one(warn_subs is None and subs_on)
    if rc > 0 and not items and any(RE_SUB_ERROR.search(e) for e in errors):
        send({"req": req, "event": "info",
              "message": "Subtitle fetch failed — retrying video without subtitles"})
        warn_subs = warn_subs or (SUB_RATELIMITED if _ratelimited("\n".join(errors)) else SUB_FAILED)
        rc, out_dir, errors, titles = run_one(False)

    current_proc = None
    # A negative rc means yt-dlp was killed by a signal; the only source is
    # our own cancel handler. The flag check also covers a cancel that landed
    # just after run_one returned cleanly.
    if cancel_flag or (isinstance(rc, int) and rc < 0):
        osd_close()
        send({"req": req, "event": "cancelled", "items": items})
        cancel_flag = False
        set_busy(False)
        return
    if rc != 0 and not items:
        msg = errors[0] if errors else "yt-dlp failed"
        msg = clean(msg, 400) or "yt-dlp failed"
        osd_close()
        notify_error(msg)
        send({"req": req, "event": "error", "message": msg})
        set_busy(False)
        return
    if sel.get("chapters") == "split" and items:
        # yt-dlp keeps every whole video next to its section files; drop each
        # redundant original and report the sections as the download result.
        split_items = []
        for whole in items:
            sections = split_sections(whole)
            if not sections:
                continue
            try:
                os.remove(whole)
            except OSError:
                pass
            title = titles.get(whole)
            if title:
                for p in sections:
                    titles[p] = title
            split_items.extend(sections)
        if split_items:
            items = split_items
    osd_close()
    send(dict({"req": req, "event": "done", "items": items}, **(warn_subs and {"warn": warn_subs} or {})))
    if len(items) > 1:
        notify_many(len(items), titles.get(items[0]) or "", out_dir)
    else:
        for p in items:
            notify_done(titles.get(p) or os.path.basename(p), p)
    set_busy(False)


# ------------------------------------------------------------------- main ---

def main():
    global current_proc, cancel_flag, lock_proc, busy
    requests = queue.Queue()

    def reader():
        while True:
            frame = read_frame(sys.stdin.buffer)
            if frame is None:
                requests.put(None)
                return
            requests.put(frame)

    threading.Thread(target=reader, daemon=True).start()

    while True:
        frame = requests.get()
        if frame is None:
            break
        req = frame.get("req")
        action = frame.get("action")

        if action == "cancel":
            with STATE_LOCK:
                proc = current_proc
                lproc = lock_proc
                if busy:
                    cancel_flag = True
            if proc is not None:
                try:
                    proc.terminate()
                except Exception:
                    pass
            if lproc is not None:
                try:
                    lproc.terminate()
                except Exception:
                    pass
            send({"req": req, "ok": True})
            continue

        if action == "ping":
            send({"req": req, "ok": True, "host": HOST_NAME,
                  "ytdlp": os.path.exists(YTDLP), "ffmpeg": os.path.exists(FFMPEG)})
            continue

        if action == "probe":
            url = http_url(frame.get("url"))
            if url is None:
                send({"req": req, "ok": False, "error": "Unsupported URL"})
                continue
            result, err = probe_info(url)
            if result is None:
                send({"req": req, "ok": False, "error": err or "probe failed"})
            else:
                send({"req": req, "ok": True, **result})
            continue

        if action == "download":
            if busy:
                send({"req": req, "event": "error", "message": "A download is already running"})
                continue
            set_busy(True)
            threading.Thread(target=download_worker, args=(req, frame), daemon=True).start()
            continue

        if action == "theme":
            theme = read_theme()
            if theme is None:
                send({"req": req, "ok": False, "error": "no theme available"})
            else:
                send({"req": req, "ok": True, "theme": theme})
            continue

        send({"req": req, "ok": False, "error": "unknown action"})


if __name__ == "__main__":
    main()